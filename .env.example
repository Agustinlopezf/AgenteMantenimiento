LLM_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://localhost:11434
USE_REAL_LLM=false
# Contexto del LLM (tokens), temperatura y modo "thinking" de Qwen (más lento)
LLM_NUM_CTX=8192
LLM_TEMPERATURE=0.2
LLM_THINK=false
EMBEDDING_MODEL=BAAI/bge-m3
# auto = GPU si hay, si no CPU
EMBEDDING_DEVICE=auto
# true = Qdrant local en disco | false = índice numpy (mismo contrato)
USE_QDRANT=true
INDEX_DIR=artifacts/index
RETRIEVAL_K=6
WEB_SEARCH_ALLOWLIST=rockwellautomation.com
# demo = solo manuales públicos | completo = todo lo indexable
CORPUS=demo
# Chunking ingenuo (hito 1): caracteres por chunk y solapamiento, dentro de cada página
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
